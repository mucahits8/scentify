{
  "expo": {
    "name": "Scentify",
    "slug": "scentify",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "scentify",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F9F8F5"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mucahit.scentify.app"
    },
    "android": {
      "package": "com.mucahit.scentify.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F9F8F5"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Scentify koleksiyonunuza parfüm eklemek için fotoğraf erişimi gerekiyor.",
          "cameraPermission": "Scentify parfüm şişelerini tanımak için kamera erişimi gerekiyor."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
